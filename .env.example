POSTGRES_PORT=55432
POSTGRES_DB=assessflow
POSTGRES_USER=assessflow_local
POSTGRES_PASSWORD=local_only_change_me
DB_URL=jdbc:postgresql://localhost:55432/assessflow
DB_USERNAME=assessflow_local
DB_PASSWORD=local_only_change_me
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_WS_URL=ws://localhost:8080/ws
# Scaled profile (docker compose -f compose.scale.yaml up -d). Leave unset for local/Local Live.
# APP_REALTIME_BROKER_MODE=relay
# APP_REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# RABBITMQ_HOST=localhost
# RABBITMQ_STOMP_PORT=61613
# RABBITMQ_USERNAME=assessflow
# RABBITMQ_PASSWORD=change_me_not_guest
# APP_HTTP_PROXY_MODE=none
# APP_HTTP_TRUSTED_PROXY=false
# SERVER_FORWARD_HEADERS_STRATEGY=none
# APP_AUTH_REFRESH_COOKIE_SAME_SITE=Strict
# APP_REPLICAS=1
# Cloud frontend (Cloudflare Pages); never localhost in a cloud build:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_PUBLIC_APP_URL=https://app.example.com
# VITE_WS_URL=wss://api.example.com/ws
